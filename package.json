{
  "name": "pi-batch-openrouter",
  "version": "0.1.0",
  "description": "Deterministic OpenRouter Batch API manager for Pi coding agent. Offload heavy goals & tasks at 50% discount with background tracking, statusline badge, and interactive TUI inspector.",
  "type": "module",
  "license": "MIT",
  "author": "mastnacek",
  "homepage": "https://github.com/mastnacek/pi-batch-openrouter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastnacek/pi-batch-openrouter.git"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "openrouter",
    "batch-api",
    "claude-opus",
    "async-goals",
    "cost-optimization"
  ],
  "files": [
    "index.ts",
    "src",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "build": "tsc",
    "web": "tsc -p tsconfig.test.json && node .test-build/src/web/cli.js",
    "test": "tsc -p tsconfig.test.json && node --test --test-timeout=30000 --test-reporter=spec \".test-build/test/**/*.test.js\""
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "0.86.0",
    "@earendil-works/pi-tui": "^0.86.1",
    "@types/node": "^22.20.4",
    "@types/pdfkit": "0.17.6",
    "typebox": "^1.3.34",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "csv-parse": "5.6.0",
    "marked": "18.0.11",
    "pdf-lib": "1.17.1",
    "pdfkit": "0.20.2",
    "yaml": "2.9.0"
  }
}
